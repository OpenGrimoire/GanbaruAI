{
  "identifier": "android",
  "description": "Android capability for the single app-owned webview",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:app:allow-register-listener",
    "core:app:allow-remove-listener",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
