{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["GANBARU_AI_RELEASE_REPOSITORY"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "editor-check": {
      "inputs": [
        "index.html",
        "package.json",
        "scripts/check-tailwind-diagnostics.mjs",
        "src/**/*.css",
        "src/**/*.html",
        "src/**/*.js",
        "src/**/*.mjs",
        "src/**/*.svelte",
        "src/**/*.ts",
        "svelte.config.js",
        "vite.config.ts"
      ]
    },
    "bundle-contracts": {
      "dependsOn": ["build"],
      "inputs": [
        "package.json",
        "scripts/check-first-use-bundle.mjs",
        "scripts/first-use-bundle-baseline.json"
      ]
    }
  }
}
