<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <permission
        android:name="${applicationId}.permission.INTERNAL_GUARDIAN"
        android:protectionLevel="signature" />

    <uses-permission android:name="${applicationId}.permission.INTERNAL_GUARDIAN" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <provider
            android:name="app.ganbaru.mobile_doomscrolling.DoomscrollingGuardianProvider"
            android:authorities="${applicationId}.ganbaru.guardian.doomscrolling"
            android:exported="false"
            android:process=":guardian" />

        <service
            android:name="app.ganbaru.mobile_doomscrolling.DoomscrollingAccessibilityService"
            android:exported="true"
            android:label="@string/ganbaru_doomscrolling_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":guardian">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/doomscrolling_accessibility_service" />
        </service>

        <receiver
            android:name="app.ganbaru.mobile_doomscrolling.DoomscrollingPhaseReceiver"
            android:exported="false"
            android:process=":guardian">
            <intent-filter>
                <action android:name="app.ganbaru.intent.action.DOOMSCROLLING_PHASE" />
                <action android:name="app.ganbaru.intent.action.DOOMSCROLLING_PHASE_CLEAR" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
